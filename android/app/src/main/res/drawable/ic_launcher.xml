<?xml version="1.0" encoding="utf-8"?>
<!-- Значок: светящееся кольцо, как в окне ассистента. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#03080F" />
            <size android:width="108dp" android:height="108dp" />
        </shape>
    </item>
    <item android:bottom="8dp" android:left="8dp" android:right="8dp" android:top="8dp">
        <shape android:shape="oval">
            <stroke android:width="4dp" android:color="#00B4D8" />
        </shape>
    </item>
    <item android:bottom="18dp" android:left="18dp" android:right="18dp" android:top="18dp">
        <shape android:shape="oval">
            <solid android:color="#0A3A4A" />
            <stroke android:width="3dp" android:color="#7DF9FF" />
        </shape>
    </item>
</layer-list>
